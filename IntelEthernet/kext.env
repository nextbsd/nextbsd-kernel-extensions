# IntelEthernet.kext: FreeBSD's e1000 driver (if_em: the em and igb families).
# No firmware. To be retired once em is compiled back into the kernel
# (nextbsd-kernel#328). Read by tools/kexts.sh; the fields are described there.
KEXT_NAME=IntelEthernet
KEXT_ID=org.nextbsd.kext.intelethernet
KEXT_ARCHES="amd64"
KEXT_MODULE=em
KEXT_KO=if_em.ko
KEXT_PERSONALITIES="gen-em-personalities.sh sys/dev/e1000"
KEXT_FIRMWARE=""
