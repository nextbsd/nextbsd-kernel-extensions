drm_atomic_helper: bound the plane fence wait and name what it is stuck on

Same diagnostic as the v3d wait_bo side, for the other door into the hang.
Uses plain printf() rather than drm_err(): drm_err output has never once
reached dmesg on this platform -- zero "[drm] *ERROR*" lines across every
boot today -- so a diagnostic built on drm_err is silently mute, which is
exactly what happened on the first attempt.

diff --git a/drivers/gpu/drm/drm_atomic_helper.c b/drivers/gpu/drm/drm_atomic_helper.c
index 40e4e1b..f860f44 100644
--- a/drivers/gpu/drm/drm_atomic_helper.c
+++ b/drivers/gpu/drm/drm_atomic_helper.c
@@ -1643,7 +1643,47 @@ int drm_atomic_helper_wait_for_fences(struct drm_device *dev,
 		 * still interrupt the operation. Instead of blocking until the
 		 * timer expires, make the wait interruptible.
 		 */
+#ifdef __FreeBSD__
+		/*
+		 * dma_fence_wait() is unbounded and on a Pi 500+ it never
+		 * returns: the desktop wedges with a thread parked in
+		 * dma_fence_default_wait() while dev.v3d.0.state reports every
+		 * queue at emit == done, outstanding=0. So the fence is not an
+		 * outstanding GPU job and nothing will complete or reset it.
+		 *
+		 * Wait in bounded slices and name what we are stuck on.
+		 * Deliberately plain printf(): drm_err() output has never once
+		 * reached dmesg on this platform (zero "[drm] *ERROR*" lines
+		 * across every boot), so a diagnostic built on it is mute.
+		 */
+		{
+			struct dma_fence *f = new_plane_state->fence;
+			signed long rem;
+			int secs = 0;
+
+			for (;;) {
+				rem = dma_fence_wait_timeout(f, pre_swap,
+							     5L * HZ);
+				if (rem != 0)
+					break;
+				secs += 5;
+				printf("V3DSTUCK: [PLANE:%d] commit stuck %ds fence %s/%s ctx %llu seqno %llu signalled=%d\n",
+				    plane->base.id, secs,
+				    (f->ops != NULL &&
+				     f->ops->get_driver_name != NULL) ?
+				    f->ops->get_driver_name(f) : "?",
+				    (f->ops != NULL &&
+				     f->ops->get_timeline_name != NULL) ?
+				    f->ops->get_timeline_name(f) : "?",
+				    (unsigned long long)f->context,
+				    (unsigned long long)f->seqno,
+				    dma_fence_is_signaled(f));
+			}
+			ret = (rem < 0) ? (int)rem : 0;
+		}
+#else
 		ret = dma_fence_wait(new_plane_state->fence, pre_swap);
+#endif
 		if (ret)
 			return ret;
 
