# IntelWiFi.kext: FreeBSD's iwlwifi driver (every model from 7260 to AX210 and
# BE200), with the full linux-firmware iwlwifi set bundled in. Intel permits
# unmodified binary redistribution with the licence alongside, so it ships too.
# Read by tools/kexts.sh; the fields are described there.
KEXT_NAME=IntelWiFi
KEXT_ID=org.nextbsd.kext.intelwifi
KEXT_ARCHES="amd64"
KEXT_MODULE=iwlwifi
KEXT_KO=if_iwlwifi.ko
KEXT_PERSONALITIES="gen-iwlwifi-personalities.sh sys/contrib/dev/iwlwifi/pcie/drv.c"
KEXT_FIRMWARE="intel/iwlwifi LICENCE.iwlwifi_firmware"
