# RealtekRE.kext: Realtek's own re driver for its PCIe Ethernet family (1G to
# 10G), vendored from net/realtek-re-kmod; replaces base re(4) (E21 D14).
# Built from this directory's Makefile (src/ is upstream, see VENDOR.md).
KEXT_NAME=RealtekRE
KEXT_ID=org.nextbsd.driver.RealtekRE
KEXT_ARCHES="amd64 arm64"
KEXT_MODULE=local
KEXT_KO=if_re.ko
KEXT_CATEGORY=hwdriver
KEXT_MATCH=required
KEXT_PERSONALITIES=""
KEXT_FIRMWARE=""
KEXT_REQUIRED="Network-Root"
