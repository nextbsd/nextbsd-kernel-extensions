 /*
+ * NextBSD: process LP_SyncConnectInfo, what the controller negotiated for a
+ * SCO or eSCO link (nextbsd/nextbsd-kernel#237). It comes just before
+ * LP_ConnectCfm, while the socket is still connecting, and again when the
+ * link's parameters change.
+ */
+
+static int
+ng_btsocket_sco_process_lp_sync_con_info(struct ng_mesg *msg,
+		ng_btsocket_sco_rtentry_p rt)
+{
+	ng_hci_lp_sync_con_info_ep	*ep = NULL;
+	ng_btsocket_sco_pcb_t		*pcb = NULL;
+
+	if (msg->header.arglen != sizeof(*ep))
+		return (EMSGSIZE);
+
+	ep = (ng_hci_lp_sync_con_info_ep *)(msg->data);
+
+	mtx_lock(&ng_btsocket_sco_sockets_mtx);
+
+	if (ep->changed)
+		pcb = ng_btsocket_sco_pcb_by_handle(&rt->src, ep->con_handle);
+	else
+		pcb = ng_btsocket_sco_pcb_by_addrs(&rt->src, &ep->bdaddr);
+
+	if (pcb != NULL) {
+		/* pcb is locked */
+		ng_btsocket_sco_sync_set_info(pcb, ep);
+		mtx_unlock(&pcb->pcb_mtx);
+	}
+
+	mtx_unlock(&ng_btsocket_sco_sockets_mtx);
+
+	return (0);
+} /* ng_btsocket_sco_process_lp_sync_con_info */
