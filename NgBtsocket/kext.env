# NgBtsocket.kext: FreeBSD's ng_btsocket module, the Bluetooth sockets,
# category netgraph. Built from this directory's Makefile, not sys/modules,
# with NextBSD's changes in src/ (nextbsd/nextbsd-kernel#237): SCO and eSCO
# parameters on SCO sockets (SO_SCO_SYNC_PARAMS, SO_SCO_SYNC_INFO,
# ng_btsocket_sco_sync.h), for bluetoothd's HFP Audio Gateway.
# Read by tools/kexts.sh; the fields are described there.
KEXT_NAME=NgBtsocket
KEXT_ID=org.nextbsd.net.NgBtsocket
KEXT_ARCHES="amd64 arm64"
KEXT_MODULE=local
KEXT_KO=ng_btsocket.ko
KEXT_CATEGORY=netgraph
KEXT_MATCH=none
KEXT_PERSONALITIES=""
KEXT_FIRMWARE=""
KEXT_REQUIRED="Safe Boot"
