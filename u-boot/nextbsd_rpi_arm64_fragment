# NextBSD additions to rpi_arm64_defconfig (nextbsd/nextbsd#687).
# build-u-boot.sh appends this to the defconfig; a later line wins.
#
# Boot chain: EEPROM firmware -> FAT: u-boot.bin -> U-Boot's EFI ->
# FAT: EFI/BOOT/bootaa64.efi (FreeBSD loader.efi) -> /boot on UFS or ZFS.

# As FreeBSD's sysutils/u-boot-rpi-arm64 does (files/rpi_arm64_fragment):
# no device for the FAT environment, so a uboot.env on some FAT partition is
# never loaded and the built-in environment below is always the one used.
CONFIG_ENV_FAT_DEVICE_AND_PART=""
CONFIG_RPI_EFI_NR_SPIN_PAGES=2

# Never wait at a prompt. A Pi 500+ has no keyboard in U-Boot (USB is behind
# RP1, which U-Boot does not drive) and usually no serial cable, so a prompt
# is a hung board that needs someone to pull the power.
#
# -2: run bootcmd at once and do not check for a key to abort it.
CONFIG_BOOTDELAY=-2
#
# bootcmd: load loader.efi from the first FAT partition of the disk the
# firmware booted from, then of the other one, and start it with the device
# tree the firmware handed U-Boot (fdt_addr: the firmware's patched DTB,
# overlays applied). If loader.efi is missing, fails to start, or returns,
# reset: the next boot is the firmware's again, so a tryboot test falls back
# to config.txt.
#
# The firmware records the disk in /chosen/bootloader/boot-mode (1 = SD,
# 6 = NVMe). Starting the loader from that disk matters for ZFS: loader.efi
# looks for a pool on its own disk and boots the pool's bootfs, which is
# what makes `bectl activate` work. Started from the other disk it never
# sees the pool (measured on a Pi 500+, nextbsd/nextbsd#687). The firmware
# tries SD before NVMe, so an SD card with a boot partition wins there too.
# Anything else (no such property, USB boot) keeps NVMe first. `fdt get value`
# prints a one-cell property as 0x%08X, hence 0x00000001.
CONFIG_CMD_FDT=y
# Deliberately not `bootflow scan`: it would also try extlinux, scripts and
# the network, and boot whatever it found first.
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="setenv nbmode 0; fdt addr ${fdt_addr} && fdt get value nbmode /chosen/bootloader boot-mode; echo NextBSD: firmware boot-mode ${nbmode}; if test ${nbmode} = 0x00000001; then for nbdev in mmc nvme; do if load ${nbdev} 0:1 ${kernel_addr_r} efi/boot/bootaa64.efi; then echo NextBSD: starting loader.efi from ${nbdev} 0:1; bootefi ${kernel_addr_r} ${fdt_addr}; echo NextBSD: loader.efi returned; fi; done; else for nbdev in nvme mmc; do if load ${nbdev} 0:1 ${kernel_addr_r} efi/boot/bootaa64.efi; then echo NextBSD: starting loader.efi from ${nbdev} 0:1; bootefi ${kernel_addr_r} ${fdt_addr}; echo NextBSD: loader.efi returned; fi; done; fi; setenv stdout serial,vidconsole; setenv stderr serial,vidconsole; echo NextBSD: no bootable loader.efi, resetting in 5 seconds; sleep 5; reset"
#
# If anything still reaches the command line (a bootcmd that stops early, a
# command that drops to the prompt), reset after 15 idle seconds.
CONFIG_BOOT_RETRY=y
CONFIG_BOOT_RETRY_TIME=15
CONFIG_RESET_TO_RETRY=y
#
# A U-Boot panic or a synchronous abort resets the board (the default; kept
# explicit so a later defconfig cannot turn it into a hang).
# CONFIG_PANIC_HANG is not set

# Version banner: "U-Boot 2026.10-nextbsd1". No git suffix, so the string does
# not depend on how the patches were applied.
CONFIG_LOCALVERSION="-nextbsd1"
# CONFIG_LOCALVERSION_AUTO is not set

# No `usb start` before booting. The Pi 5's USB controllers are behind RP1,
# which U-Boot does not drive, and the first hardware attempt on a Pi 500+
# hung somewhere with no console to say where (nextbsd/nextbsd#687); USB
# setup is the first suspect. NVMe is on pcie1 and needs only these two.
CONFIG_PREBOOT="pci enum; nvme scan;"

# Silent on the screen (nextbsd/nextbsd#542, nextbsd-kernel-extensions#39).
# A normal boot draws nothing between the firmware and loader.efi's boot
# splash: no logo, and patch 0004 sends stdout and stderr to serial only.
# The display is still probed, so loader.efi gets its GOP framebuffer, and
# the screen stays the black U-Boot cleared it to. bootcmd's failure path
# above switches the screen back on before it prints: there is usually no
# serial cable, so the screen is the only place a failure shows.
# CONFIG_VIDEO_LOGO is not set
#
# That failure text: 16x32 characters instead of 8x16 (tiny on a 1440p
# panel), white on black.
CONFIG_VIDEO_FONT_16X32=y
# CONFIG_VIDEO_FONT_8X16 is not set
CONFIG_SYS_WHITE_ON_BLACK=y
