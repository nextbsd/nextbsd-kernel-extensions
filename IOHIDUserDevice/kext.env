# IOHIDUserDevice.kext: vhid, a hidbus transport whose devices a root daemon
# creates from userland through /dev/hidresource, modelled on Darwin's
# IOHIDUserDevice and IOHIDResourceDeviceUserClient (nextbsd-kernel-extensions#25).
# bluetoothd's HID host makes each Bluetooth keyboard, mouse and trackpad one,
# and hkbd, hms, hmt and the HID kexts attach as they do for USB. A software
# device, so it has no personality and is loaded on request by bluetoothd.
# Built from this directory's Makefile; src/hidresource.h is the ioctl and
# read(2) interface userland includes.
KEXT_NAME=IOHIDUserDevice
KEXT_ID=org.nextbsd.kext.IOHIDUserDevice
KEXT_ARCHES="amd64 arm64"
KEXT_MODULE=local
KEXT_KO=vhid.ko
KEXT_CATEGORY=kernel-misc
KEXT_MATCH=none
KEXT_PERSONALITIES=""
KEXT_FIRMWARE=""
KEXT_REQUIRED="Safe Boot"
