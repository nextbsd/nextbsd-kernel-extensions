# autofs.kext: FreeBSD's automounter filesystem (/dev/autofs, vfs.autofs),
# like Apple's com.apple.filesystems.autofs. No IOKitPersonalities: nothing
# matches it; automount loads it on first use (nextbsd/nextbsd#537, through
# the shared filesystem kext loader, nextbsd-userland#436). Not compiled into
# the kernel: boot never needs it. Read by tools/kexts.sh.
KEXT_NAME=autofs
KEXT_ID=org.nextbsd.filesystems.autofs
KEXT_ARCHES="amd64 arm64"
KEXT_MODULE=autofs
KEXT_KO=autofs.ko
KEXT_PERSONALITIES=""
KEXT_FIRMWARE=""
