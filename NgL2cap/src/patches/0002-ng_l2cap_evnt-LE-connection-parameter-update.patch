ng_l2cap: check and apply LE connection parameter update requests

ng_l2cap_process_cmd_urq() answered every L2CAP Connection Parameter
Update Request on the LE signalling channel (CID 5) with ACCEPT without
reading it, and nothing ever asked the controller to apply it, so a
mouse that asks for a 7.5 ms interval stayed at the connect-time one
and some peripherals disconnect after an accepted request that never
takes effect.

Read the request, check it against the Core spec's limits
(ng_hci_le_con_params_valid(), NgHCI's ng_hci_le_lp.h): interval 7.5 ms
to 4 s with min <= max, latency at most 499, supervision timeout 100 ms
to 32 s and longer than (1 + latency) * interval_max * 2. Reject what
fails, or a short request. Accept the rest and send
NGM_HCI_LP_LE_CON_UPDATE_REQ to ng_hci (ng_l2cap_le.c, this directory's
src/), which issues LE_Connection_Update with the peripheral's values.

Origin: NextBSD (nextbsd/nextbsd-kernel#234). Not upstream.
Applies to: releng/15.1 sys/netgraph/bluetooth/l2cap/ng_l2cap_evnt.c

--- a/sys/netgraph/bluetooth/l2cap/ng_l2cap_evnt.c
+++ b/sys/netgraph/bluetooth/l2cap/ng_l2cap_evnt.c
@@ -51,6 +51,10 @@
 #include <netgraph/bluetooth/l2cap/ng_l2cap_ulpi.h>
 #include <netgraph/bluetooth/l2cap/ng_l2cap_misc.h>
 
+/* NextBSD: LE hardening (nextbsd/nextbsd-kernel#234) */
+#include "ng_hci_le_lp.h"
+#include "ng_l2cap_le.h"
+
 /******************************************************************************
  ******************************************************************************
  **                    L2CAP events processing module
@@ -357,12 +361,61 @@ ng_l2cap_process_lesignal_cmd(ng_l2cap_con_p con)
 	return (0);
 } /* ng_l2cap_process_signal_cmd */
 /*Update Paramater Request*/
+/*
+ * NextBSD: check the peripheral's parameters against the Core spec's limits,
+ * answer, and have ng_hci apply accepted ones with LE_Connection_Update
+ * (nextbsd/nextbsd-kernel#234). releng/15.1 accepted every request without
+ * reading it and never applied it.
+ */
 static int ng_l2cap_process_cmd_urq(ng_l2cap_con_p con, uint8_t ident)
 {
-	/* We do not implement parameter negotiation for now. */
-	send_l2cap_param_urs(con, ident, NG_L2CAP_UPDATE_PARAM_ACCEPT);
+	ng_l2cap_p			 l2cap = con->l2cap;
+	ng_l2cap_param_update_req_cp	*cp = NULL;
+	u_int16_t			 imin, imax, lat, timo;
+	int				 error;
+
+	if (con->rx_pkt->m_pkthdr.len < sizeof(*cp)) {
+		NG_L2CAP_ERR(
+"%s: %s - short connection parameter update request, ident=%d, len=%d\n",
+			__func__, NG_NODE_NAME(l2cap->node), ident,
+			con->rx_pkt->m_pkthdr.len);
+		send_l2cap_param_urs(con, ident, NG_L2CAP_UPDATE_PARAM_REJECT);
+		NG_FREE_M(con->rx_pkt);
+		return (EMSGSIZE);
+	}
+
+	NG_L2CAP_M_PULLUP(con->rx_pkt, sizeof(*cp));
+	if (con->rx_pkt == NULL)
+		return (ENOBUFS);
+
+	cp = mtod(con->rx_pkt, ng_l2cap_param_update_req_cp *);
+	imin = le16toh(cp->interval_min);
+	imax = le16toh(cp->interval_max);
+	lat = le16toh(cp->slave_latency);
+	timo = le16toh(cp->timeout_mpl);
 	NG_FREE_M(con->rx_pkt);
-	return 0;
+
+	if (!ng_hci_le_con_params_valid(imin, imax, lat, timo)) {
+		NG_L2CAP_ERR(
+"%s: %s - rejected connection parameters, con_handle=%d, " \
+"interval=%d-%d, latency=%d, timeout=%d\n",
+			__func__, NG_NODE_NAME(l2cap->node), con->con_handle,
+			imin, imax, lat, timo);
+		send_l2cap_param_urs(con, ident, NG_L2CAP_UPDATE_PARAM_REJECT);
+		return (0);
+	}
+
+	send_l2cap_param_urs(con, ident, NG_L2CAP_UPDATE_PARAM_ACCEPT);
+
+	error = ng_l2cap_lp_le_con_update(con, imin, imax, lat, timo);
+	if (error != 0)
+		NG_L2CAP_ERR(
+"%s: %s - could not request LE connection update, con_handle=%d, " \
+"error=%d\n",
+			__func__, NG_NODE_NAME(l2cap->node), con->con_handle,
+			error);
+
+	return (0);
 }
 
 static int ng_l2cap_process_cmd_urs(ng_l2cap_con_p con, uint8_t ident)
