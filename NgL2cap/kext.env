# NgL2cap.kext: FreeBSD's ng_l2cap module, the Bluetooth L2CAP layer, category
# netgraph. Built from this directory's Makefile, not sys/modules, with
# NextBSD's changes in src/ (nextbsd/nextbsd-kernel#234): LE connection
# parameter update requests checked and applied through ng_hci, LE frames split
# to fit any LE buffer pool, and no panic on an unknown queued command. It
# shares ng_hci_le_lp.h with NgHCI (../NgHCI/src).
# Read by tools/kexts.sh; the fields are described there.
KEXT_NAME=NgL2cap
KEXT_ID=org.nextbsd.net.NgL2cap
KEXT_ARCHES="amd64 arm64"
KEXT_MODULE=local
KEXT_KO=ng_l2cap.ko
KEXT_CATEGORY=netgraph
KEXT_MATCH=none
KEXT_PERSONALITIES=""
KEXT_FIRMWARE=""
KEXT_REQUIRED="Safe Boot"
