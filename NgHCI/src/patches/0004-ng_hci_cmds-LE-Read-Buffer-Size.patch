ng_hci: take the LE data pool from LE_Read_Buffer_Size

LE_Read_Buffer_Size (v1 and v2) sat in process_le_params()'s "no post
processing" list, so the controller's LE data pool was never used.

Pass the LE packet length and count to ng_hci_le_buffer_set()
(ng_hci_le.c, this directory's src/). A non-zero count gives the unit
its own LE pool, which 0003-ng_hci_evnt-LE-buffer-pool.patch sends
from; zero leaves LE sharing the ACL pool. The v2 reply adds the ISO
pool after the same fields, which ng_hci does not use. ng_hci never
sends the command itself: whoever initialises the controller on the raw
hook (bluetoothd) does, after Read_Buffer_Size.

Also accept the Command Complete for the LE Remote Connection Parameter
Request reply and negative reply (OCF 0x0020 and 0x0021), which
ng_hci_le.c now sends, instead of returning EINVAL for them.

Origin: NextBSD (nextbsd/nextbsd-kernel#234). Not upstream.
Applies to: releng/15.1 sys/netgraph/bluetooth/hci/ng_hci_cmds.c

--- a/sys/netgraph/bluetooth/hci/ng_hci_cmds.c
+++ b/sys/netgraph/bluetooth/hci/ng_hci_cmds.c
@@ -49,6 +49,9 @@
 #include <netgraph/bluetooth/hci/ng_hci_ulpi.h>
 #include <netgraph/bluetooth/hci/ng_hci_misc.h>
 
+/* NextBSD: LE hardening (nextbsd/nextbsd-kernel#234) */
+#include "ng_hci_le.h"
+
 /******************************************************************************
  ******************************************************************************
  **                     HCI commands processing module
@@ -820,8 +823,34 @@ process_le_params(ng_hci_unit_p unit, u_int16_t ocf,
 	int	error = 0;
 
 	switch (ocf){
-	case NG_HCI_OCF_LE_SET_EVENT_MASK:
+	/*
+	 * NextBSD: the LE data pool (nextbsd/nextbsd-kernel#234). v2 adds the
+	 * ISO pool after the same three fields. A zero size or count means
+	 * LE shares the ACL pool.
+	 */
 	case NG_HCI_OCF_LE_READ_BUFFER_SIZE:
+	case NG_HCI_OCF_LE_READ_BUFFER_SIZE_V2: {
+		ng_hci_le_read_buffer_size_rp	*rp = NULL;
+
+		NG_HCI_M_PULLUP(mrp, sizeof(*rp));
+		if (mrp != NULL) {
+			rp = mtod(mrp, ng_hci_le_read_buffer_size_rp *);
+			ng_hci_le_buffer_set(unit,
+				le16toh(rp->hc_le_data_packet_length),
+				rp->hc_total_num_le_data_packets);
+
+			/* LE data may now go out of its own pool */
+			ng_hci_send_data(unit);
+		} else
+			error = ENOBUFS;
+		} break;
+
+	/* NextBSD: answers to LE Remote Connection Parameter Request (#234) */
+	case NG_HCI_OCF_LE_REMOTE_CONN_PARAM_REQ_REPLY:
+	case NG_HCI_OCF_LE_REMOTE_CONN_PARAM_REQ_NEG_REPLY:
+		break;
+
+	case NG_HCI_OCF_LE_SET_EVENT_MASK:
 	case NG_HCI_OCF_LE_READ_LOCAL_SUPPORTED_FEATURES:
 	case NG_HCI_OCF_LE_SET_RANDOM_ADDRESS:
 	case NG_HCI_OCF_LE_SET_ADVERTISING_PARAMETERS:
