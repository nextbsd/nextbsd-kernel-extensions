ng_hci: return LE packets to the LE pool when a connection goes

ng_hci_free_con() assumes the controller flushed a dying connection's
pending packets and credits them back. With an LE pool
(0003-ng_hci_evnt-LE-buffer-pool.patch) an LE link's packets go back to
that pool, not the ACL one. ng_hci_unit_clean(), which drops every
connection, also refills the LE pool, as it refills the ACL and SCO
pools.

Origin: NextBSD (nextbsd/nextbsd-kernel#234). Not upstream.
Applies to: releng/15.1 sys/netgraph/bluetooth/hci/ng_hci_misc.c

--- a/sys/netgraph/bluetooth/hci/ng_hci_misc.c
+++ b/sys/netgraph/bluetooth/hci/ng_hci_misc.c
@@ -48,6 +48,9 @@
 #include <netgraph/bluetooth/hci/ng_hci_ulpi.h>
 #include <netgraph/bluetooth/hci/ng_hci_misc.h>
 
+/* NextBSD: LE hardening (nextbsd/nextbsd-kernel#234) */
+#include "ng_hci_le.h"
+
 /******************************************************************************
  ******************************************************************************
  **                              Utility routines
@@ -164,6 +167,9 @@ ng_hci_unit_clean(ng_hci_unit_p unit, int reason)
 	NG_HCI_BUFF_SCO_TOTAL(unit->buffer, size);
 	NG_HCI_BUFF_SCO_FREE(unit->buffer, size);
 
+	/* NextBSD: and the LE pool, if the controller has one (#234) */
+	ng_hci_le_buffer_reset(unit);
+
 	/* Clean up neighbors list */
 	ng_hci_flush_neighbor_cache(unit);
 } /* ng_hci_unit_clean */
@@ -315,10 +321,17 @@ ng_hci_free_con(ng_hci_unit_con_p con)
 	 * flushed these packets and we can free them too
 	 */
 
-	if (con->link_type != NG_HCI_LINK_SCO)
-		NG_HCI_BUFF_ACL_FREE(con->unit->buffer, con->pending);
-	else
+	switch (ng_hci_le_buffer_class(con->unit, con->link_type)) {
+	case NG_HCI_LINK_SCO:
 		NG_HCI_BUFF_SCO_FREE(con->unit->buffer, con->pending);
+		break;
+	case NG_HCI_BUFF_CLASS_LE:	/* NextBSD (#234) */
+		ng_hci_le_buffer_free(con->unit, con->pending);
+		break;
+	default:
+		NG_HCI_BUFF_ACL_FREE(con->unit->buffer, con->pending);
+		break;
+	}
 
 	NG_BT_ITEMQ_DESTROY(&con->conq);
 
