# NgHCI.kext: FreeBSD's ng_hci module, the Bluetooth HCI layer, category
# netgraph. Built from this directory's Makefile, not sys/modules, with
# NextBSD's changes in src/ (nextbsd/nextbsd-kernel#234): LE connections from
# LE Enhanced Connection Complete, a separate LE ACL buffer pool from
# LE_Read_Buffer_Size, LE_Connection_Update on behalf of ng_l2cap, answers to
# LE Remote Connection Parameter Request, and no panic on a bad LP_ConnectReq;
# and (nextbsd/nextbsd-kernel#237) SCO and eSCO links with
# Setup/Accept_Synchronous_Connection, Synchronous_Connection_Complete and
# _Changed, and SCO data without SCO flow control.
# Read by tools/kexts.sh; the fields are described there.
KEXT_NAME=NgHCI
KEXT_ID=org.nextbsd.net.NgHCI
KEXT_ARCHES="amd64 arm64"
KEXT_MODULE=local
KEXT_KO=ng_hci.ko
KEXT_CATEGORY=netgraph
KEXT_MATCH=none
KEXT_PERSONALITIES=""
KEXT_FIRMWARE=""
KEXT_REQUIRED="Safe Boot"
