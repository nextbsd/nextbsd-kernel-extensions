 /*
+ * NextBSD: move interface 1 to another alternate setting and set its
+ * isochronous transfers up again for the new packet size
+ * (nextbsd/nextbsd-kernel#237). Called by ng_ubt_sco.c from the USB explore
+ * process, which serializes it with enumeration and detach; ubt_detach()
+ * waits for it (ubt_sco_detach()).
+ */
+
+int
+ubt_isoc_set_alt(struct ubt_softc *sc, struct usb_device *udev,
+    const uint8_t *iface_index, uint8_t alt)
+{
+	usb_error_t	err;
+	int		i, running, error = 0;
+
+	/* Let a glue task that is starting or stopping transfers finish */
+	taskqueue_drain(taskqueue_swi, &sc->sc_task);
+
+	for (i = UBT_IF_1_ISOC_DT_RD1; i <= UBT_IF_1_ISOC_DT_WR2; i ++)
+		usbd_transfer_drain(sc->sc_xfer[i]);
+	usbd_transfer_unsetup(&sc->sc_xfer[UBT_IF_1_ISOC_DT_RD1],
+	    UBT_N_TRANSFER - UBT_IF_1_ISOC_DT_RD1);
+
+	/* A half reassembled SCO packet belongs to the old stream */
+	mtx_lock(&sc->sc_if_mtx);
+	NG_FREE_M(sc->sc_isoc_in_buffer);
+	mtx_unlock(&sc->sc_if_mtx);
+
+	err = usbd_set_alt_interface_index(udev, iface_index[1], alt);
+	if (err != 0) {
+		UBT_ALERT(sc, "could not set alternate setting %d " \
+			"for interface 1, error=%s\n", alt, usbd_errstr(err));
+		error = ENXIO;
+	}
+
+	if (!ng_usb_isoc_enable)
+		return (error);
+
+	if (usbd_transfer_setup(udev, iface_index,
+	    &sc->sc_xfer[UBT_IF_1_ISOC_DT_RD1], &ubt_config[UBT_IF_1_ISOC_DT_RD1],
+	    UBT_N_TRANSFER - UBT_IF_1_ISOC_DT_RD1, sc, &sc->sc_if_mtx)) {
+		UBT_ALERT(sc, "could not allocate isoc transfers\n");
+		return (ENXIO);
+	}
+
+	/* Restart them if the stack above is connected, as ubt_task() does */
+	UBT_NG_LOCK(sc);
+	running = (sc->sc_hook != NULL);
+	UBT_NG_UNLOCK(sc);
+
+	if (running) {
+		mtx_lock(&sc->sc_if_mtx);
+		ubt_xfer_start(sc, UBT_IF_1_ISOC_DT_RD1);
+		ubt_xfer_start(sc, UBT_IF_1_ISOC_DT_RD2);
+		ubt_xfer_start(sc, UBT_IF_1_ISOC_DT_WR1);
+		ubt_xfer_start(sc, UBT_IF_1_ISOC_DT_WR2);
+		mtx_unlock(&sc->sc_if_mtx);
+	}
+
+	return (error);
+} /* ubt_isoc_set_alt */
