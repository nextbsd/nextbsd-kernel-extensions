# NgUbt.kext: FreeBSD's ng_ubt module, the USB Bluetooth HCI transport. A
# hardware driver (E21 D12): it autoloads through its USB personalities, which
# the build requires. Built from this directory's Makefile, not sys/modules,
# with NextBSD's changes in src/: each controller is published in the
# IORegistry as an IOBluetoothHostController entry, which bluetoothd matches
# (nextbsd-kernel-extensions#27), and interface 1's isochronous alternate
# setting follows the controller's SCO and eSCO links, so headset audio flows
# at the packet size the controller expects (nextbsd/nextbsd-kernel#237).
#
# The Intel (ibt-*) and Realtek (rtl_bt) Bluetooth firmware ships in the bundle,
# in Contents/Resources/firmware/intel and .../rtl_bt with each vendor's licence,
# from linux-firmware; bluetoothd downloads it to a part that enumerates in
# bootloader mode (nextbsd/nextbsd#476). Both licences permit unmodified binary
# redistribution with the licence alongside.
# Read by tools/kexts.sh; the fields are described there.
KEXT_NAME=NgUbt
KEXT_ID=org.nextbsd.net.NgUbt
KEXT_ARCHES="amd64 arm64"
KEXT_MODULE=local
KEXT_KO=ng_ubt.ko
KEXT_CATEGORY=hwdriver
KEXT_MATCH=required
KEXT_PERSONALITIES=""
KEXT_FIRMWARE="intel=intel/ibt-* intel=LICENCE.ibt_firmware rtl_bt=rtl_bt/* rtl_bt=LICENCE.rtlwifi_firmware.txt"
KEXT_REQUIRED="Safe Boot"
